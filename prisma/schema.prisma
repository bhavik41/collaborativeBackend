// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model user {
  id       String   @id @default(cuid()) @map("_id")
  email    String   @unique
  password String
  projects String[] @default([]) // Store project IDs as an array of strings
}

model Project {
  id            String         @id @default(cuid()) @map("_id")
  name          String
  creator       String
  language      String
  description   String
  collaborators Collaborator[]
  fileTree      Json           @default("[]")
  adminOnlyEdit Boolean        @default(false) // New field
  version       Int            @default(0) @map("__v")
  messages      Message[] // Array of message objects
  scheduledTime DateTime? // New field
  expiryTime    DateTime?
}

type Collaborator {
  id          String
  accessLevel String // "admin", "readwrite", or "readonly"
  addedAt     DateTime @default(now())
}

type Message {
  sender    String
  message   String
  createdAt DateTime @default(now())
}

model ShareLink {
  id          String   @id @default(cuid()) @map("_id")
  token       String   @unique
  projectId   String
  accessLevel String   @default("readonly") // Default access level for new collaborators
  createdAt   DateTime @default(now())
  expiresAt   DateTime
}
